{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dave-lawn-desk-web",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"not_found_handling": "single-page-application",
		// /api/* must reach the Worker even for browser navigations, which the
		// SPA fallback would otherwise answer with index.html.
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Backend Worker (put-ai-to-work-challenge/backend). Deploy it first.
	"services": [{ "binding": "API", "service": "dave-lawn-desk-api" }]
}
