{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dave-lawn-desk-api",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// No public *.workers.dev URL: the frontend Worker reaches this one through a
	// service binding, so the API is not exposed on its own.
	"workers_dev": false,
	"preview_urls": false,
	// Workers Traces shows each agent response as a trace with agent-level spans.
	"observability": { "traces": { "enabled": true } },
	// Keyless `cloudflare/...` models run through this Workers AI binding.
	"ai": { "binding": "AI" },
	// App-owned Durable Object (exported from src/cloudflare.ts): one per visitor.
	// Flue adds the bindings for its generated agent classes itself.
	"durable_objects": {
		"bindings": [{ "name": "VISITOR_STORE", "class_name": "VisitorStore" }]
	},
	// Every agent generates a SQLite-backed Durable Object class named after its
	// identity (LawnDesk -> FlueLawnDeskAgent). Append a new tag for each new class;
	// never rewrite a deployed entry.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueLawnDeskAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["VisitorStore"] }
	]
}
